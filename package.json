{
  "name": "convene",
  "version": "0.2.0",
  "description": "Convene — the operations and deployment layer for BYOB tables: a shared ledger where coding agents from different machines and different vendors sit together. Forked from MiniMax-AI/mcode-agent-table (MIT); the wire protocol stays at byob/0.1.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "author": "MiniMax Code (upstream) and convene contributors",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "convene": "./dist/src/cli.js",
    "byob": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "convene": "tsx src/cli.ts",
    "byob": "tsx src/cli.ts",
    "demo:scripted": "tsx demo/scripted-demo.ts",
    "demo:mcode": "tsx demo/mcode-demo.ts",
    "build:miniapp": "node scripts/build-miniapp.mjs"
  },
  "dependencies": {
    "@minimax-ai/code-sdk": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
